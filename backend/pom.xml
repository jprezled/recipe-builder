<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot's parent POM pins compatible versions of every library below,
         so individual dependencies carry no <version> tag of their own. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.recipebuilder</groupId>
    <artifactId>recipe-builder</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>recipe-builder</name>
    <description>Find recipes from the ingredients you already have</description>

    <properties>
        <!-- Target 17 so the build works on any JDK 17 or newer, whatever each
             teammate has installed. -->
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- Spring MVC plus an embedded Tomcat, and RestClient for outbound calls. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JUnit 5, AssertJ, Mockito and MockRestServiceServer.
             Test scope = never shipped in the application. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
