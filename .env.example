# Copy this file to ".env" and fill in your own values.
#   cp .env.example .env            (Mac, Linux, or Git Bash on Windows)
#   Copy-Item .env.example .env     (Windows PowerShell)
#
# .env is gitignored and must NEVER be committed.
#
# Every teammate needs their OWN free key. The free tier is 150 points
# per day PER KEY, so six people sharing one key will run out by lunch.
#
#   Register at: https://spoonacular.com/food-api
#
# NO TRAILING SPACES after the key. Spring reads this file as a properties
# file, which strips spaces BEFORE a value but keeps the ones after it. Those
# spaces get sent to Spoonacular as part of the key and the request fails with
# "Spoonacular rejected our API key" - which looks like a bad key and is not.
# Paste the key, delete anything after it, then save.
#
# To check your own file - one key plus a newline is exactly 53 bytes:
#   wc -c < .env                    (Mac, Linux, or Git Bash on Windows)
#   (Get-Item .env).Length          (Windows PowerShell)

SPOONACULAR_API_KEY=your_spoonacular_key_here
