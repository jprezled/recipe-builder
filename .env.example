# Copy this file to ".env" and fill in your own values.
#   cp .env.example .env            (Mac, Linux, or Git Bash on Windows)
#   Copy-Item .env.example .env     (Windows PowerShell)
#
# .env is gitignored and must NEVER be committed.
#
# Every teammate needs their OWN free key. The free tier is 150 points
# per day PER KEY, so six people sharing one key will run out by lunch.
#
#   Register at: https://spoonacular.com/food-api
#
# NO TRAILING SPACES after the key. Spring reads this file as a properties
# file, which strips spaces BEFORE a value but keeps the ones after it. Those
# spaces get sent to Spoonacular as part of the key and the request fails with
# "Spoonacular rejected our API key" - which looks like a bad key and is not.
# Paste the key, delete anything after it, then save.
#
# To check your own file - one key plus a newline is exactly 53 bytes:
#   wc -c < .env                    (Mac, Linux, or Git Bash on Windows)
#   (Get-Item .env).Length          (Windows PowerShell)

SPOONACULAR_API_KEY=your_spoonacular_api_key

# ---------------------------------------------------------------------------
# PostgreSQL (sprint 2 — needed for saving favorites)
# ---------------------------------------------------------------------------
# Set these up by following database/README.md first: it creates the two
# databases and applies the migrations.
#
# DATABASE_USER is your Postgres role, NOT your project username:
#   Homebrew on a Mac  — usually your own macOS username, and the password is
#                        often blank because local connections are trusted
#   Windows installer  — usually "postgres", with the password you chose
#                        during installation
#
# If you leave these out entirely the app falls back to "postgres" with a blank
# password, which works on some machines and fails with an authentication error
# on others. Setting them explicitly is less confusing than finding out which.
#
# NO TRAILING SPACES after any value — Spring reads this file as a properties
# file and keeps whitespace after a value, sending it as part of the value.
DATABASE_URL=jdbc:postgresql://localhost:5432/recipe_builder_db
DATABASE_USER=your_postgres_user
DATABASE_PASSWORD=your_postgres_password
